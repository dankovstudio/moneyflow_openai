# Copy to .env and fill in locally. Never commit .env.

# CoinGecko Demo API key: https://www.coingecko.com/en/api/pricing
COINGECKO_DEMO_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Numeric chat ID allowed to add expenses through the bot
TELEGRAM_ALLOWED_CHAT_ID=

# Basic Auth for the site and /api (login: moneyflow). Empty = open, as in local development.
APP_PASSWORD=

# Bearer token for the MCP read API (/internal/mcp/*), the same value as on Vercel. Empty = read API off (404).
MCP_READ_TOKEN=

# Optional overrides (defaults shown). The Docker image sets HOST=0.0.0.0 and DB_PATH=/app/data/moneyflow.sqlite.
# HOST=127.0.0.1
# PORT=8787
# DB_PATH=data/moneyflow.sqlite

# docker compose only: host folder mounted as /app/data (Dokploy: ../files/moneyflow-data)
# DATA_DIR=./data
