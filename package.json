{
  "name": "moneyflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --clear-screen=false --disable-warning=ExperimentalWarning server/index.ts",
    "bot": "tsx --disable-warning=ExperimentalWarning server/telegram/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
